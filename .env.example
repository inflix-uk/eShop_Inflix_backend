# Marketing analytics — attribution on orders (Phase 1A)
# ISO 8601 UTC date when storefront attribution tracking began.
MARKETING_TRACKING_STARTED_AT=2026-06-29T00:00:00.000Z
# Secret for hashing guest emails into customerKey (use a long random value in production).
MARKETING_ATTRIBUTION_HMAC_SECRET=replace-with-long-random-secret

# Google Ads spend: import CSV via scripts/importMarketingAdSpend.js or POST /analytics/ad-spend (admin).
# Campaign names must match order marketingAttribution.normalized.campaign / UTM campaign.

# ---------------------------------------------------------------------------
# SMTP / Gmail — transactional emails (orders, booking updates, contact form)
# Admin → Settings → SMTP can override these when fields are saved in the DB.
# For Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords).
# ---------------------------------------------------------------------------


# Storefront URL (links in booking emails)
FRONTEND_URL=http://localhost:3000

# Booking status emails to customers (cancel, reschedule, no-show). Set false to disable.
BOOKING_STATUS_EMAILS_ENABLED=true
